{
  "name": "zuk-gestionale",
  "productName": "Zuk Gestionale",
  "version": "1.0.0",
  "description": "Gestionale clienti: appuntamenti, fatturazione e acquisti",
  "main": "src/main/main.js",
  "author": "Zuk",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ezullo-cmd/zuk.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.zuk.gestionale",
    "productName": "Zuk Gestionale",
    "artifactName": "Zuk-Gestionale-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ezullo-cmd",
        "repo": "zuk",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
